    {
      "id": "jVXKzmIbAG_ash27Rd7Dm",
      "type": "text",
      "x": -1017.8932203420654,
      "y": -2736.6756223693997,
      "width": 514.2530517578125,
      "height": 152.64081461783056,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 2139950779,
      "version": 771,
      "versionNonce": 361317685,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779435728582,
      "link": null,
      "locked": false,
      "text": "Característica: Reserva de inventario\n\n  Escenario: Reservar stock disponible\n    Dado que existe un producto con 10 unidades disponibles\n    Cuando el usuario reserva 2 unidades\n    Entonces la reserva se crea correctamente\n    Y el stock disponible queda en 8",
      "fontSize": 17.444664527752064,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Característica: Reserva de inventario\n\n  Escenario: Reservar stock disponible\n    Dado que existe un producto con 10 unidades disponibles\n    Cuando el usuario reserva 2 unidades\n    Entonces la reserva se crea correctamente\n    Y el stock disponible queda en 8",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VGHpbW1JwBCfNaPCPY4LL",
      "type": "text",
      "x": -967.4145844367732,
      "y": -2525.076954573879,
      "width": 349.9715860897915,
      "height": 154.7178826260988,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
